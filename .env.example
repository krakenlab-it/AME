# ════════════════════════════════════════════════════════════════════
# Portal de actualización de datos — variables de entorno
# Copia este archivo a .env (local) y configura las mismas en Vercel.
# NUNCA subas .env ni claves reales al repositorio.
# ════════════════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────────────────
# URL del proyecto y clave service_role: SOLO servidor. Nunca uses NEXT_PUBLIC_ en la service_role.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# URL pública (el mismo proyecto) y clave anon. El navegador solo las usa para la sesión
# de Supabase Auth del panel /admin. No abren people, tokens ni otros datos personales:
# esas tablas siguen con RLS en DENY ALL. No pongas aquí la service_role.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Criptografía (genera con: npm run keys:generate) ─────────────────
# AES-256-GCM: 32 bytes en base64. Si se pierde, los datos cifrados no se recuperan.
ENCRYPTION_KEY=
# Solo durante una rotación de llave: la llave anterior
ENCRYPTION_KEY_PREVIOUS=
# Pepper para hashes (cédula, IP). Mínimo 32 caracteres. No cambiar después de importar datos.
HASH_PEPPER=
# Secreto para el cron de retención (Vercel lo envía como Bearer)
CRON_SECRET=

# ── Aplicación ───────────────────────────────────────────────────────
# URL pública usada para construir los enlaces individuales
APP_BASE_URL=https://actualizacion.tudominio.com
# Días de vigencia de cada enlace (1–180)
TOKEN_TTL_DAYS=30
# production | preview | development (en Vercel se detecta con VERCEL_ENV)
APP_STAGE=
ORGANIZATION_NAME=Agrupación Marista Ecuatoriana
# Correo o teléfono que ve el titular para soporte
SUPPORT_CONTACT=

# ── Datos legales (LEGAL_REVIEW_REQUIRED) ────────────────────────────
# No inventar: completar con la información validada por el área legal.
PRIVACY_RESPONSIBLE_LEGAL_NAME=
PRIVACY_RESPONSIBLE_RUC=
PRIVACY_RESPONSIBLE_ADDRESS=
PRIVACY_EMAIL=
PRIVACY_PHONE=
# Opcional ("cuando corresponda"); si está vacío no se muestra
PRIVACY_DPO=
# Razón social exacta de la aseguradora destinataria
PRIVACY_RECIPIENT_LEGAL_NAME=
PRIVACY_NOTICE_VERSION=1.0
PRIVACY_NOTICE_EFFECTIVE_DATE=
# Retención (JSON): meses, motivo y fecha de expiración opcional (AAAA-MM-DD)
DATA_RETENTION_POLICY={"months":60,"reason":"[MOTIVO / BASE LEGAL O CONTRACTUAL DEL PLAZO DE CONSERVACIÓN]","expiresAt":""}
# Solo "true" cuando el área legal apruebe los textos. En producción, sin esto el portal se bloquea.
LEGAL_REVIEW_APPROVED=false

# ── CAPTCHA adaptativo (opcional, Cloudflare Turnstile) ──────────────
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Correo de confirmación y enlaces personales (opcional, Resend) ──
# Sin estas dos, el paso 3 no envía correos. Generar enlaces faltantes sigue descargando el CSV.
RESEND_API_KEY=
EMAIL_FROM="Actualización de datos <no-responder@tudominio.com>"

# ── Carga en vivo hacia Unibrokers (opcional) ────────────────────────
# Sin estas dos, el panel solo descarga el paquete de contacto.
# El formato que acepta el sistema de Unibrokers todavía no está confirmado:
# si ambas existen, el portal intenta un POST JSON y, pase lo que pase, entrega el archivo.
UNIBROKERS_API_URL=
UNIBROKERS_API_KEY=

# ── Solo desarrollo ──────────────────────────────────────────────────
# Fuerza cookies Secure/__Host- aunque se ejecute en local con HTTPS
FORCE_SECURE_COOKIES=false
# Modo demostración local con datos ficticios en memoria (sin Supabase). Nunca en producción.
DEMO_MODE=false
